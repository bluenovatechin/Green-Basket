# Copy to .env.local for development. These values are public (they ship to the browser).
# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: Cloudflare Turnstile site key (bot check on login). Also enable CAPTCHA in Supabase Auth settings.
VITE_TURNSTILE_SITE_KEY=

# Private address of the admin panel (letters, digits, - or _). Default: gb-console -> /gb-console
# Pick something only your team knows, e.g. gb-staff-7k2. The admin role is still required.
VITE_ADMIN_PATH=

# Public address of the live site, no trailing slash (canonical links, sitemap.xml, robots.txt, social previews).
# e.g. https://greenbasket.in
VITE_SITE_URL=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXX). Loaded ONLY after a visitor accepts analytics cookies.
VITE_GA4_ID=

# Optional: Google Search Console "HTML tag" verification code (just the content="..." value).
VITE_GSC_VERIFICATION=
