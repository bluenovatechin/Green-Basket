{
  "name": "@green-basket/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:ghpages": "tsc -b && vite build --mode ghpages && node scripts/gh-pages-prep.mjs",
    "deploy": "npm run build:ghpages && gh-pages -d dist --dotfiles -m \"Deploy to GitHub Pages\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.4",
    "@tanstack/react-query": "5.62.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "gh-pages": "6.1.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1"
  }
}
