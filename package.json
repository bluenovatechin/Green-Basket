{
  "name": "green-basket",
  "private": true,
  "version": "0.1.0",
  "description": "Green Basket: fresh fruit and vegetable delivery for one city",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
