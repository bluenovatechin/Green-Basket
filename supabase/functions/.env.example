# Edge Function secrets. Set them with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.)

# The public web address of the shop (used in emails, PhonePe redirect, CORS)
APP_URL=https://greenbasket.in

# Shared secret between pg_cron and the worker functions (same value as the Vault secret 'cron_secret')
CRON_SECRET=generate-a-long-random-string

# Brevo (transactional email API key + a sender verified in Brevo)
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=orders@greenbasket.in
EMAIL_FROM_NAME=Green Basket

# PhonePe Payment Gateway (from the PhonePe Business dashboard)
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Cloudflare R2 (product photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=greenbasket-images
R2_PUBLIC_URL=https://img.greenbasket.in
